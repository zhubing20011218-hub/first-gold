{
  "name": "first-gold",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "check": "node scripts/check/run.mjs",
    "check:full": "node scripts/check/run.mjs --full",
    "prepare": "git config core.hooksPath .githooks",
    "sim": "vite build --ssr scripts/simulate.ts --outDir node_modules/.sim --emptyOutDir --logLevel warn && node node_modules/.sim/simulate.js",
    "shots": "vite build --logLevel warn && vite build --ssr scripts/shots.ts --outDir node_modules/.shots --emptyOutDir --logLevel warn && node node_modules/.shots/shots.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slider": "^1.6.1",
    "clsx": "^2.1.1",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
